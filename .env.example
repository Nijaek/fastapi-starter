# Project
PROJECT_NAME=FastAPI Starter
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/fastapi_starter

# Auth (SECRET_KEY must be at least 32 characters)
SECRET_KEY=your-super-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array format)
CORS_ORIGINS=["http://localhost:3000"]

# Redis (required for token revocation)
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
